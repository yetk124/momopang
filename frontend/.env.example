# frontend/.env — 브라우저에 공개돼도 되는 값만 (VITE_)
# 비밀 키는 backend 쪽 Supabase secrets 로!

# ── Supabase (없으면 봇/같은 브라우저 탭 모드로만 동작) ──
VITE_SUPABASE_URL=https://xxxx.supabase.co
# anon(public) 키만 넣으세요. service_role 키는 절대 넣지 마세요!
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# true: 익명 로그인 + 비공개 실시간 채널 (schema.sql의 realtime 정책 주석 해제 필요)
VITE_SUPABASE_PRIVATE_CHANNELS=false

# ── Google Analytics 4 (없으면 수집 안 함) ──
# GA 관리 > 데이터 스트림 > 웹 > 측정 ID (G-로 시작)
VITE_GA_MEASUREMENT_ID=

# ── 카카오 로그인 (Supabase Auth의 Kakao provider 설정 후 true) ──
VITE_KAKAO_LOGIN=false
